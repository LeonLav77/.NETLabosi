@model Vjezba.Model.Client

@{
    ViewData["Title"] = "Edit Client";
}

<h1>Edit Client</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="ID" />
            <partial name="_CreateOrUpdate" />
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Client Attachments</h5>
            </div>
            <div class="card-body">
                <label class="control-label">Upload Documents</label>
                <form id="attachmentDz" asp-controller="Client" asp-action="UploadAttachment"
                      asp-route-clientId="@Model.ID"
                      enctype="multipart/form-data" class="dropzone"></form>
                
                <div id="attachmentsContainer" class="mt-4">
                    <!-- Attachment list will be loaded here via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
<script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css" type="text/css" />
    <script type="text/javascript">
        $(document).ready(function() {
            // Load attachments when the page loads
            loadAttachments();
            
            // Handle delete attachment
            $(document).on('click', '.delete-attachment', function() {
                var attachmentId = $(this).data('id');
                
                if (confirm('Are you sure you want to delete this attachment?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteAttachment", "Client")',
                        type: 'POST',
                        data: { id: attachmentId },
                        success: function() {
                            // Reload the attachments list
                            loadAttachments();
                        },
                        error: function(xhr, status, error) {
                            alert('Error deleting attachment: ' + error);
                        }
                    });
                }
            });
        });
        
        function loadAttachments() {
            $.ajax({
                url: '@Url.Action("GetAttachments", "Client")',
                type: 'GET',
                data: { clientId: @Model.ID },
                success: function(data) {
                    $('#attachmentsContainer').html(data);
                },
                error: function(xhr, status, error) {
                    console.error('Error loading attachments:', error);
                }
            });
        }
        
        // Configure Dropzone
        Dropzone.options.attachmentDz = {
            paramName: "file", // Name of the input field (default is "file")
            maxFilesize: 10, // MB
            addRemoveLinks: true,
            dictDefaultMessage: "Drop files here or click to upload",
            dictRemoveFile: "Remove",
            success: function(file, response) {
                console.log('File uploaded:', response);
                // Reload the attachments list
                loadAttachments();
            },
            complete: function(file) {
                // Clear the Dropzone preview after upload
                if (file.status === "success") {
                    setTimeout(function() {
                        Dropzone.forElement("#attachmentDz").removeFile(file);
                    }, 3000);
                }
            },
            error: function(file, errorMessage) {
                console.error('Error uploading file:', errorMessage);
            }
        };
    </script>
}