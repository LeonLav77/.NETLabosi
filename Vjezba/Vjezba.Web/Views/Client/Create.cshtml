@using Vjezba.Model
@model Client

@{
    ViewData["Title"] = "Create Client";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="nav-link">Clients</a></li>
        <li class="breadcrumb-item active" aria-current="page">Create New</li>
    </ol>
</nav>

<h2>Create New Client</h2>

<div class="row">
    <div class="col-md-12">
        <form asp-controller="Client" asp-action="Create" method="post" id="clientForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <partial name="_CreateOrUpdate" model="Model" />
            
            <div class="row">
                <div class="col">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary" id="cancelButton">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var formIsDirty = false;
            var allowNavigation = false;
            
            var emailField = $("input[name='Email']");
            
            $("#clientForm :input").on("change input", function() {
                formIsDirty = true;
            });
            
            emailField.focus(function() {
                if ($("#email-hint").length === 0) {
                    $("<div id='email-hint' class='form-text text-muted mt-1'>Please enter a valid email address (e.g., example@domain.com)</div>")
                        .insertAfter(emailField.closest(".form-group"));
                } else {
                    $("#email-hint").show();
                }
            });
            
            emailField.blur(function() {
                $("#email-hint").hide();
            });
            
            $("#clientForm").submit(function() {
                formIsDirty = false;
                allowNavigation = true;
                return true;
            });
            
            function handleNavigation(e) {
                if (formIsDirty && !allowNavigation) {
                    if (!confirm("You have unsaved changes. Are you sure you want to leave this page?")) {
                        if (e) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                        return false;
                    } else {
                        allowNavigation = true;
                        return true;
                    }
                }
                return true;
            }
            
            $("#cancelButton").click(function(e) {
                return handleNavigation(e);
            });
            
            window.addEventListener("beforeunload", function(e) {
                if (formIsDirty && !allowNavigation) {
                    var confirmationMessage = "You have unsaved changes. Are you sure you want to leave this page?";
                    
                    (e || window.event).returnValue = confirmationMessage;
                    return confirmationMessage;
                }
            });
            
            $(document).on("click", "a:not([href^='#']):not([href^='javascript']):not([type='submit'])", function(e) {
                return handleNavigation(e);
            });
        });
    </script>
}