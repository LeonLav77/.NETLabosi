@model List<Vjezba.Model.Client>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Address</th>
            <th>Email</th>
            <th>City</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.ID</td>
                <td>@client.FullName</td>
                <td>@client.Address</td>
                <td>@client.Email</td>
                <td>@client.City?.Name</td>
                <td>
                    <div class="btn-group">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-action="Details" asp-route-id="@client.ID" class="btn btn-info btn-sm">Details</a>
                        }

                        
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@client.ID" class="btn btn-primary btn-sm">Edit</a>
                        }
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@client.ID" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this client?');"
                                  style="display: inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>